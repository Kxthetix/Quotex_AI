# Trading Intelligence System Environment Variables

# Environment
APP_ENV=development
LOG_LEVEL=INFO
LOG_FORMAT=console

# Market Data Settings
DATA_PROVIDER=binance
MARKET_SYMBOLS=BTCUSDT,ETHUSDT
WS_BASE_URL=wss://stream.binance.com:9443/ws
REST_BASE_URL=https://api.binance.com
STALE_DATA_TIMEOUT_SECONDS=15.0
MAX_RECONNECT_ATTEMPTS=10
INITIAL_RECONNECT_DELAY_SECONDS=1.0
MAX_RECONNECT_DELAY_SECONDS=30.0

# Database Settings (TimescaleDB / PostgreSQL)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=trading_db
POSTGRES_POOL_SIZE=10

# Redis Cache Settings
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# MLflow Settings
MLFLOW_TRACKING_URI=http://localhost:5000

# File Storage Paths
RAW_STORAGE_PATH=data/storage/raw
CLEANED_STORAGE_PATH=data/storage/cleaned
PARQUET_STORAGE_PATH=data/storage/parquet
